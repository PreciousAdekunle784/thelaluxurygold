# --- Admin -------------------------------------------------------------------
# Password for /admin. Use a long, unique passphrase.
ADMIN_PASSWORD=
# Optional: separate secret used to sign admin sessions (rotating it signs everyone out).
ADMIN_SESSION_SECRET=

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Railway, RDS…). Required on serverless
# hosts such as Vercel. Leave empty to use a local SQLite file at .data/llg.sqlite.
DATABASE_URL=
# SQLITE_PATH=.data/llg.sqlite

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://laluxurygold.com
# Naira per US dollar until a rate is saved in /admin → Store settings.
NEXT_PUBLIC_NGN_PER_USD=1550
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_STORE_TIME_ZONE=Asia/Dubai

# --- Private Collection ---------------------------------------------------------
# Optional secret used to fingerprint private access codes (HMAC). If empty, a random one is
# generated and kept in the database. Changing it invalidates every issued code.
PRIVATE_ACCESS_SECRET=

# --- Payments (Paystack) -------------------------------------------------------
# Secret key from Paystack Dashboard → Settings → API Keys & Webhooks. Server only — never commit it.
PAYSTACK_SECRET_KEY=
# Public key (not required by the hosted checkout; kept for reference)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Optional webhooks (forward submissions to email/CRM automations) ---------
ORDER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# --- Admin -------------------------------------------------------------------
# Password for /admin. Use a long, unique passphrase.
ADMIN_PASSWORD=
# Optional: separate secret used to sign admin sessions (rotating it signs everyone out).
ADMIN_SESSION_SECRET=

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Railway, RDS…). Required on serverless
# hosts such as Vercel. Leave empty to use a local SQLite file at .data/llg.sqlite.
DATABASE_URL=
# SQLITE_PATH=.data/llg.sqlite

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://laluxurygold.com
NEXT_PUBLIC_SAMPLE_CATALOGUE=true
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_STORE_TIME_ZONE=Asia/Dubai

# --- Optional webhooks (forward submissions to email/CRM automations) ---------
ORDER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
